import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
         Scanner in = new Scanner(System.in);

        int n = in.nextInt();
        int m = in.nextInt();

        Deque<Integer> deque = new ArrayDeque<>();
        Map<Integer, Integer> frequency = new HashMap<>();

        int maxUnique = 0;

        for (int i = 0; i < n; i++) {
            int num = in.nextInt();

            // Add number to the window
            deque.addLast(num);
            frequency.put(num, frequency.getOrDefault(num, 0) + 1);

            // If window is bigger than m, remove first element
            if (deque.size() > m) {
                int removed = deque.removeFirst();

                int count = frequency.get(removed);

                if (count == 1) {
                    frequency.remove(removed);
                } else {
                    frequency.put(removed, count - 1);
                }
            }

            // Check unique numbers in current window
            if (deque.size() == m) {
                maxUnique = Math.max(maxUnique, frequency.size());
            }
        }

        System.out.println(maxUnique);

        in.close();
    }
}
